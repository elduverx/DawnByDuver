{%- liquid
  assign excluded_handles = 'productos-con-descuento-por-cantidad' | split: ','
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500&display=swap" rel="stylesheet">

{%- style -%}
  #VelaColeccionesScroll-{{ section.id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #VelaColeccionesScroll-{{ section.id }} {
      display: block;
      background: #f5f5f5;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #VelaColeccionesScroll-{{ section.id }}::-webkit-scrollbar {
      display: none;
    }

    #VelaColeccionesScroll-{{ section.id }} .vela-colecciones-scroll__track {
      display: inline-flex;
      align-items: center;
      padding: 0 1.2rem;
    }

    #VelaColeccionesScroll-{{ section.id }} .vela-colecciones-scroll__item {
      display: inline-flex;
      align-items: center;
      padding: 7px 6px;
      font-family: 'Montserrat', sans-serif;
      font-size: 12.25px;
      font-weight: 400;
      text-transform: none;
      letter-spacing: normal;
      color: #000000;
      text-decoration: none;
      white-space: nowrap;
      flex-shrink: 0;
    }
  }
{%- endstyle -%}

<div id="VelaColeccionesScroll-{{ section.id }}" class="vela-colecciones-scroll">
  <div class="vela-colecciones-scroll__track">
    {%- for collection in collections -%}
      {%- unless excluded_handles contains collection.handle or collection.handle == 'frontpage' or collection.products_count == 0 -%}
        <a href="{{ collection.url }}" class="vela-colecciones-scroll__item">{{ collection.title }}</a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Colecciones Scroll",
  "presets": [
    {
      "name": "Colecciones Scroll"
    }
  ]
}
{% endschema %}