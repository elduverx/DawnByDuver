{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{%- assign banner_desktop_image = images['ChatGPT_Image_20_ago_2026_11_15_22.png'] -%}
{%- assign banner_mobile_image = images['ChatGPT_Image_20_ago_2026_11_15_22.png'] -%}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">

{%- style -%}
  .collection-hero.collection-hero--with-image {
    position: relative;
    padding: 0 !important;
    overflow: hidden !important;
  }

  @media screen and (max-width: 749px) {
    .collection-hero.collection-hero--with-image {
      margin-top: 0 !important;
    }
  }
  @media screen and (min-width: 990px) {
    .collection-hero.collection-hero--with-image {
      margin-top: 0 !important;
    }
  }

  .collection-hero--with-image .collection-hero__image-container {
    position: relative;
    width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    z-index: 1;
  }

  .collection-hero--with-image .collection-hero__image-container img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .collection-hero--with-image .collection-hero__image-container picture {
    position: static !important;
    display: block !important;
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
  }

  .collection-hero--with-image .collection-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
    height: 100%;
  }

  .collection-hero--with-image .collection-hero__text-wrapper {
    position: absolute;
    left: 2rem;
    bottom: 1.5rem;
    z-index: 2;
    padding: 0 !important;
    margin: 0 !important;
    flex-basis: auto !important;
    max-width: none !important;
  }

  .collection-hero--with-image .collection-hero__title {
    margin: 0 !important;
    color: #ffffff;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 500;
    text-transform: none;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  .collection-hero--with-image .collection-hero__kicker {
    display: block;
    margin: 0 0 0.6rem;
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  @media screen and (min-width: 750px) {
    .collection-hero--with-image .collection-hero__text-wrapper {
      left: 3rem;
      bottom: 2.5rem;
    }

    .collection-hero--with-image .collection-hero__image-container {
      flex: none !important;
      margin-left: 0 !important;
      min-height: 0 !important;
      align-self: auto !important;
    }

    .collection-hero--with-image .collection-hero__title {
      font-size: 3.4rem;
    }

    .collection-hero--with-image .collection-hero__kicker {
      font-size: 1.3rem;
      margin-bottom: 0.8rem;
    }
  }

  .collection-hero__aniversario {
    padding: 3rem 0 4rem;
  }

  .collection-hero__aniversario-inner {
    max-width: 70rem;
    margin: 0 auto;
    text-align: center;
    padding: 0 2rem;
  }

  .collection-hero__aniversario-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 1.2rem;
  }

  .collection-hero__aniversario-inner p {
    font-size: 1.5rem;
    line-height: 1.6;
    color: #333;
    margin: 0 0 1.2rem;
  }

  .collection-hero__aniversario-descuentos {
    list-style: none;
    padding: 0;
    margin: 0 auto 1.2rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  .collection-hero__aniversario-descuentos li {
    font-size: 1.5rem;
    font-weight: 600;
    color: #1A1A1A;
  }

  .collection-hero__aniversario-firma {
    font-style: italic;
    margin-top: 1.5rem !important;
  }

  @media screen and (min-width: 750px) {
    .collection-hero__aniversario-heading {
      font-size: 2.6rem;
    }

    .collection-hero__aniversario-inner p,
    .collection-hero__aniversario-descuentos li {
      font-size: 1.7rem;
    }
  }
{%- endstyle -%}

<div class="collection-hero collection-hero--with-image color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__image-container media gradient">
    <picture>
      <source
        media="(max-width: 749px)"
        srcset="
          {%- if banner_mobile_image.width >= 375 -%}{{ banner_mobile_image | image_url: width: 375 }} 375w,{%- endif -%}
          {%- if banner_mobile_image.width >= 750 -%}{{ banner_mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if banner_mobile_image.width >= 1125 -%}{{ banner_mobile_image | image_url: width: 1125 }} 1125w,{%- endif -%}
          {{ banner_mobile_image | image_url }} {{ banner_mobile_image.width }}w
        "
      >
      <img
        srcset="
          {%- if banner_desktop_image.width >= 750 -%}{{ banner_desktop_image | image_url: width: 750 }} 750w,{%- endif -%}
          {%- if banner_desktop_image.width >= 1070 -%}{{ banner_desktop_image | image_url: width: 1070 }} 1070w,{%- endif -%}
          {%- if banner_desktop_image.width >= 1500 -%}{{ banner_desktop_image | image_url: width: 1500 }} 1500w,{%- endif -%}
          {%- if banner_desktop_image.width >= 2000 -%}{{ banner_desktop_image | image_url: width: 2000 }} 2000w,{%- endif -%}
          {{ banner_desktop_image | image_url }} {{ banner_desktop_image.width }}w
        "
        sizes="100vw"
        src="{{ banner_desktop_image | image_url: width: 1500 }}"
        alt="{{ collection.title | escape }}"
        width="{{ banner_desktop_image.width }}"
        height="{{ banner_desktop_image.height }}"
      >
    </picture>
  </div>
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      {%- if section.settings.kicker_text != blank -%}
        <span class="collection-hero__kicker">{{ section.settings.kicker_text | escape }}</span>
      {%- endif -%}
      <h1 class="collection-hero__title visually-hidden">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>
    </div>
  </div>
</div>

<div class="collection-hero__aniversario">
  <div class="collection-hero__aniversario-inner page-width">
    <h2 class="collection-hero__aniversario-heading">Celebramos nuestro 23.º Aniversario 🤍</h2>
    <p>Hace 23 años nació Casa Velaria con una idea muy sencilla: acompañar a cada mujer con prendas con las que se sienta realmente ella misma.</p>
    <p>Hoy queremos darte las gracias a todas las mujeres que han sido parte de esta historia. Estas prendas seleccionadas son nuestro regalo de aniversario para ti: si todavía puedes hacer clic en «Añadir al carrito», la prenda aún puede ser tuya. Las unidades son limitadas y, una vez agotadas, no se repondrán.</p>
    <ul class="collection-hero__aniversario-descuentos">
      <li>2 prendas → 10% de descuento</li>
      <li>3 prendas → 15% de descuento</li>
      <li>4 prendas → 20% de descuento</li>
      <li>5 o más prendas → 25% de descuento</li>
    </ul>
    <p>Los descuentos se aplican automáticamente al finalizar tu compra. Promoción exclusiva de nuestro 23.º Aniversario.</p>
    <p>Gracias por ser parte de nuestra historia.</p>
    <p class="collection-hero__aniversario-firma">— Con cariño, Casa Velaria 🤍</p>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "text",
      "id": "kicker_text",
      "default": "HOMBRE",
      "label": "Texto pequeño encima del título (solo con imagen de colección)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagen versión móvil (opcional, recomendado formato vertical/cuadrado)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
