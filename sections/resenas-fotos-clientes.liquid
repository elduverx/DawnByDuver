{%- style -%}
  .rfc-section {
    padding: 60px 0;
    background: #ffffff;
    text-align: center;
  }
  .rfc-header__titulo {
    font-family: Georgia, serif;
    font-weight: 400;
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    color: #121212;
    margin: 0 0 14px 0;
  }
  .rfc-header__subtitulo {
    font-size: 1.4rem;
    color: #333333;
    margin: 0 0 6px 0;
  }
  .rfc-header__valoracion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 1.4rem;
    color: #333333;
    margin-bottom: 40px;
  }
  .rfc-estrellas-badge {
    display: inline-flex;
    gap: 2px;
  }
  .rfc-estrellas-badge svg,
  .rfc-card__estrellas svg {
    width: 16px;
    height: 16px;
  }
  .rfc-star--lleno path { fill: var(--rfc-star-color, #16a34a); }
  .rfc-star--vacio path { fill: #d1d5db; }

  .rfc-slider-wrapper {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .rfc-grid {
    display: flex;
    gap: 20px;
    overflow-x: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    touch-action: pan-y;
  }
  .rfc-grid::-webkit-scrollbar {
    display: none;
  }
  .rfc-card {
    flex: 0 0 auto;
    width: calc(25% - 15px);
    text-align: left;
    border: 1px solid #ececec;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  .rfc-card__imagen {
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f3f3f3;
  }
  .rfc-card__imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .rfc-card__contenido {
    padding: 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .rfc-card__texto {
    font-size: 1.35rem;
    line-height: 1.5;
    color: #222222;
    margin: 0 0 16px 0;
    flex: 1;
  }
  .rfc-card__estrellas {
    display: flex;
    gap: 2px;
    margin-bottom: 8px;
  }
  .rfc-card__fila-inferior {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    flex-wrap: wrap;
  }
  .rfc-card__badge {
    background: #f0fdf4;
    color: #15803d;
    font-size: 1.1rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 3px;
  }
  .rfc-card__nombre {
    font-size: 1.3rem;
    font-weight: 700;
    color: #121212;
    margin: 0;
  }
  .rfc-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
  }
  .rfc-btn {
    background: #ffffff;
    border: 1px solid #d1d5db;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.3rem;
    color: #6b7280;
    touch-action: manipulation;
  }
  .rfc-btn:hover {
    background: #f9fafb;
  }

  @media screen and (max-width: 989px) {
    .rfc-card { width: calc(50% - 10px); }
  }
  @media screen and (max-width: 599px) {
    .rfc-card { width: 85%; }
    .rfc-section { padding: 40px 0; }
    .rfc-slider-wrapper { padding: 0 24px; }
  }
{%- endstyle -%}

{%- capture estrella_llena -%}
<svg viewBox="0 0 24 24" class="rfc-star--lleno" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.6 6.8L12 16.9l-6.2 3.6 1.6-6.8L2.2 9l6.9-.7L12 2z"/></svg>
{%- endcapture -%}
{%- capture estrella_vacia -%}
<svg viewBox="0 0 24 24" class="rfc-star--vacio" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.6 6.8L12 16.9l-6.2 3.6 1.6-6.8L2.2 9l6.9-.7L12 2z"/></svg>
{%- endcapture -%}

<div class="rfc-section" style="--rfc-star-color: {{ section.settings.color_estrellas }};">
  <h2 class="rfc-header__titulo">{{ section.settings.titulo }}</h2>
  <p class="rfc-header__subtitulo">{{ section.settings.subtitulo }}</p>
  <div class="rfc-header__valoracion">
    <span>{{ section.settings.valoracion_texto }}</span>
    <span class="rfc-estrellas-badge">{{ estrella_llena }}{{ estrella_llena }}{{ estrella_llena }}{{ estrella_llena }}{{ estrella_llena }}</span>
  </div>

  <div class="rfc-slider-wrapper">
    <div class="rfc-grid" id="rfcSlider-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="rfc-card" {{ block.shopify_attributes }}>
          <div class="rfc-card__imagen">
            {%- if block.settings.imagen != blank -%}
              <img src="{{ block.settings.imagen | image_url: width: 600 }}" alt="{{ block.settings.nombre }}" loading="lazy">
            {%- endif -%}
          </div>
          <div class="rfc-card__contenido">
            <p class="rfc-card__texto">{{ block.settings.texto }}</p>
            <div class="rfc-card__fila-inferior">
              <div class="rfc-card__estrellas">
                {%- for i in (1..5) -%}
                  {%- if i <= block.settings.estrellas -%}{{ estrella_llena }}{%- else -%}{{ estrella_vacia }}{%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.verificado -%}
                <span class="rfc-card__badge">Verificado</span>
              {%- endif -%}
            </div>
            <p class="rfc-card__nombre">{{ block.settings.nombre }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="rfc-nav">
      <button class="rfc-btn" onclick="rfcMoverSlider('{{ section.id }}', -1)" aria-label="Anterior">&#8249;</button>
      <button class="rfc-btn" onclick="rfcMoverSlider('{{ section.id }}', 1)" aria-label="Siguiente">&#8250;</button>
    </div>
  </div>
</div>

<script>
  function rfcMoverSlider(sectionId, dir) {
    var slider = document.getElementById('rfcSlider-' + sectionId);
    if (!slider) return;
    var card = slider.querySelector('.rfc-card');
    if (!card) return;
    var gap = 20;
    var cardWidth = card.offsetWidth + gap;
    var maxScroll = slider.scrollWidth - slider.clientWidth;
    var newScroll = slider.scrollLeft + (dir * cardWidth);
    slider.scrollLeft = Math.max(0, Math.min(newScroll, maxScroll));
  }

  document.addEventListener('DOMContentLoaded', function () {
    var sliders = document.querySelectorAll('.rfc-grid');
    sliders.forEach(function (slider) {
      var startX = 0;
      var startY = 0;
      var swiping = false;
      var handled = false;
      var sectionId = slider.id.replace('rfcSlider-', '');

      slider.addEventListener('touchstart', function (e) {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        swiping = true;
        handled = false;
      }, { passive: true });

      slider.addEventListener('touchmove', function (e) {
        if (!swiping || handled) return;
        var diffX = e.touches[0].clientX - startX;
        var diffY = e.touches[0].clientY - startY;

        if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 30) {
          e.preventDefault();
          handled = true;
          rfcMoverSlider(sectionId, diffX > 0 ? 1 : -1);
        }
      }, { passive: false });

      slider.addEventListener('touchend', function () {
        swiping = false;
      });
    });
  });
</script>

{% schema %}
{
  "name": "Reseñas con fotos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Lo que dicen nuestros clientes"
    },
    {
      "type": "text",
      "id": "subtitulo",
      "label": "Subtítulo",
      "default": "Más de 5.000 mujeres satisfechas"
    },
    {
      "type": "text",
      "id": "valoracion_texto",
      "label": "Texto de valoración",
      "default": "4.8/5 - Reseñas verificadas"
    },
    {
      "type": "color",
      "id": "color_estrellas",
      "label": "Color de las estrellas",
      "default": "#16a34a"
    }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "textarea", "id": "texto", "label": "Texto de la reseña", "default": "Estoy encantada con mi compra, la calidad superó mis expectativas." },
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "María G." },
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verificado", "label": "Mostrar sello 'Verificado'", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reseñas con fotos",
      "blocks": [
        { "type": "resena" },
        { "type": "resena" },
        { "type": "resena" },
        { "type": "resena" }
      ]
    }
  ]
}
{% endschema %}