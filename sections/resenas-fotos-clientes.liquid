<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">

{%- style -%}
  .rfc-section {
    padding: 60px 0;
    background: #ffffff;
    text-align: center;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    color: rgb(0, 0, 0);
  }
  .rfc-header__titulo {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(1.8rem, 3vw, 2.3rem);
    color: #121212;
    margin: 0 0 16px 0;
  }
  .rfc-header__valoracion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: normal;
    color: rgb(0, 0, 0);
    margin-bottom: 6px;
  }
  .rfc-header__subtitulo {
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: normal;
    color: rgb(0, 0, 0);
    margin: 0 0 40px 0;
  }
  .rfc-estrellas-badge {
    display: inline-flex;
    gap: 2px;
  }
  .rfc-estrellas-badge svg,
  .rfc-card__estrellas svg {
    width: 18px;
    height: 18px;
  }
  .rfc-star--lleno path { fill: var(--rfc-star-color, #f6c343); }
  .rfc-star--vacio path { fill: #d1d5db; }

  .rfc-slider-wrapper {
    width: 100%;
    margin: 0 auto;
    padding: 0 24px;
  }
  .rfc-grid {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    touch-action: pan-y pan-x;
    scroll-snap-type: x mandatory;
    cursor: grab;
    user-select: none;
    -webkit-overflow-scrolling: touch;
  }
  .rfc-grid.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }
  .rfc-grid::-webkit-scrollbar {
    display: none;
  }
  .rfc-card {
    flex: 0 0 auto;
    width: min(400px, 82vw);
    text-align: center;
    border: 1px solid #e5e5e5;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    scroll-snap-align: center;
    background: #ffffff;
    padding: 10px 10px 0;
  }

  @media screen and (max-width: 599px) {
    .rfc-card {
      width: 88vw;
      scroll-snap-align: center;
    }
  }
  .rfc-card__imagen {
    width: 100%;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: #f3f3f3;
    border-radius: 12px;
  }
  .rfc-card__imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }
  .rfc-card__contenido {
    padding: 16px 8px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .rfc-card__estrellas {
    display: flex;
    gap: 2px;
    margin-bottom: 10px;
  }
  .rfc-card__texto {
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: normal;
    letter-spacing: normal;
    color: rgb(0, 0, 0);
    margin: 0 0 12px 0;
    flex: 1;
  }
  .rfc-card__fila-inferior {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 4px;
    flex-wrap: wrap;
  }
  .rfc-card__badge {
    background: #f0fdf4;
    color: #15803d;
    font-size: 1.05rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 3px;
  }
  .rfc-card__nombre {
    font-family: 'Montserrat', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: normal;
    color: rgb(0, 0, 0);
    margin: 0;
  }
  .rfc-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
  }
  .rfc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d1d5db;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .rfc-dot.is-active {
    background: #121212;
  }

  @media screen and (max-width: 599px) {
    .rfc-section { padding: 40px 0; }
    .rfc-slider-wrapper { padding: 0 3vw; }
  }
{%- endstyle -%}

{%- capture estrella_llena -%}
<svg viewBox="0 0 24 24" class="rfc-star--lleno" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.6 6.8L12 16.9l-6.2 3.6 1.6-6.8L2.2 9l6.9-.7L12 2z"/></svg>
{%- endcapture -%}
{%- capture estrella_vacia -%}
<svg viewBox="0 0 24 24" class="rfc-star--vacio" xmlns="http://www.w3.org/2000/svg"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.7 1.6 6.8L12 16.9l-6.2 3.6 1.6-6.8L2.2 9l6.9-.7L12 2z"/></svg>
{%- endcapture -%}

<div class="rfc-section" style="--rfc-star-color: {{ section.settings.color_estrellas }};">
  <h2 class="rfc-header__titulo">{{ section.settings.titulo }}</h2>
  <div class="rfc-header__valoracion">
    <span>{{ section.settings.valoracion_texto }}</span>
    <span class="rfc-estrellas-badge">{{ estrella_llena }}{{ estrella_llena }}{{ estrella_llena }}{{ estrella_llena }}{{ estrella_llena }}</span>
  </div>
  <p class="rfc-header__subtitulo">{{ section.settings.subtitulo }}</p>

  <div class="rfc-slider-wrapper">
    <div class="rfc-grid" id="rfcSlider-{{ section.id }}">
      {%- for block in section.blocks -%}
        <div class="rfc-card" {{ block.shopify_attributes }}>
          <div class="rfc-card__imagen">
            {%- if block.settings.imagen != blank -%}
              <img src="{{ block.settings.imagen | image_url: width: 600 }}" alt="{{ block.settings.nombre }}" loading="lazy" draggable="false">
            {%- endif -%}
          </div>
          <div class="rfc-card__contenido">
            <div class="rfc-card__estrellas">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.estrellas -%}{{ estrella_llena }}{%- else -%}{{ estrella_vacia }}{%- endif -%}
              {%- endfor -%}
            </div>
            <p class="rfc-card__texto">{{ block.settings.texto }}</p>
            <p class="rfc-card__nombre">{{ block.settings.nombre }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="rfc-dots" id="rfcDots-{{ section.id }}"></div>
  </div>
</div>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var slider = document.getElementById('rfcSlider-' + sectionId);
    var dotsWrap = document.getElementById('rfcDots-' + sectionId);
    if (!slider || !dotsWrap) return;

    var originalCards = Array.prototype.slice.call(slider.querySelectorAll('.rfc-card'));
    if (!originalCards.length) return;

    // Puntos de paginación: uno por cada reseña ORIGINAL (no por los clones)
    originalCards.forEach(function (card, i) {
      var dot = document.createElement('button');
      dot.className = 'rfc-dot' + (i === 0 ? ' is-active' : '');
      dot.setAttribute('aria-label', 'Ir a reseña ' + (i + 1));
      dot.addEventListener('click', function () {
        pauseAutoplayTemporarily();
        card.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
      });
      dotsWrap.appendChild(dot);
    });
    var dots = Array.prototype.slice.call(dotsWrap.querySelectorAll('.rfc-dot'));

    // Clona el set completo de reseñas y lo añade a continuación,
    // para que siempre haya "más" contenido esperando a la derecha.
    originalCards.forEach(function (card) {
      var clone = card.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      slider.appendChild(clone);
      var img = clone.querySelector('img');
      if (img) img.setAttribute('draggable', 'false');
    });

    var loopWidth = 0;
    function measureLoopWidth() {
      // Distancia entre el inicio de la primera tarjeta original y el inicio de su clon
      var firstOriginal = originalCards[0];
      var firstClone = slider.children[originalCards.length];
      loopWidth = firstClone.offsetLeft - firstOriginal.offsetLeft;
    }

    function updateActiveDot() {
      var sliderRect = slider.getBoundingClientRect();
      var closestIndex = 0;
      var closestDistance = Infinity;
      originalCards.forEach(function (card, i) {
        var rect = card.getBoundingClientRect();
        var distance = Math.abs(rect.left - sliderRect.left);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = i;
        }
      });
      dots.forEach(function (dot, i) {
        dot.classList.toggle('is-active', i === closestIndex);
      });
    }

    // Si el scroll entra en la zona de los clones, lo devolvemos
    // instantáneamente (sin animación) a la posición equivalente real.
    function checkInfiniteLoop() {
      if (loopWidth <= 0) return;
      if (slider.scrollLeft >= loopWidth) {
        slider.style.scrollBehavior = 'auto';
        slider.scrollLeft = slider.scrollLeft - loopWidth;
        void slider.offsetWidth;
        slider.style.scrollBehavior = '';
      }
    }

    var scrollTimeout;
    slider.addEventListener('scroll', function () {
      checkInfiniteLoop();
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(updateActiveDot, 100);
    }, { passive: true });

    // Arrastre con ratón (desktop)
    var isDown = false;
    var startX = 0;
    var startScrollLeft = 0;
    var dragMoved = false;

    slider.addEventListener('mousedown', function (e) {
      isDown = true;
      dragMoved = false;
      pauseAutoplayTemporarily();
      slider.classList.add('is-dragging');
      startX = e.pageX - slider.offsetLeft;
      startScrollLeft = slider.scrollLeft;
    });

    window.addEventListener('mouseup', function () {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove('is-dragging');
    });

    slider.addEventListener('mouseleave', function () {
      if (!isDown) return;
      isDown = false;
      slider.classList.remove('is-dragging');
    });

    slider.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      dragMoved = true;
      var x = e.pageX - slider.offsetLeft;
      var walk = x - startX;
      slider.scrollLeft = startScrollLeft - walk;
    });

    slider.addEventListener('click', function (e) {
      if (dragMoved) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    slider.addEventListener('touchstart', pauseAutoplayTemporarily, { passive: true });

    // Bloquea el arrastre nativo de imágenes (el "fantasma" al hacer drag)
    slider.querySelectorAll('img').forEach(function (img) {
      img.addEventListener('dragstart', function (e) {
        e.preventDefault();
      });
    });

    function centerOnMiddleCard() {
      var middleIndex = Math.floor(originalCards.length / 2);
      var middleCard = originalCards[middleIndex];
      if (!middleCard) return;
      var sliderRect = slider.getBoundingClientRect();
      var cardRect = middleCard.getBoundingClientRect();
      var offset = (cardRect.left - sliderRect.left) - (sliderRect.width / 2) + (cardRect.width / 2);
      slider.scrollLeft = slider.scrollLeft + offset;
      updateActiveDot();
    }

    // Avance automático cada 3 segundos: siempre suma, nunca resetea de golpe.
    // El bucle infinito real lo gestiona checkInfiniteLoop() por scroll.
    var autoplayTimer = null;
    var resumeTimer = null;
    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(function () {
        var card = originalCards[0];
        var gap = 20;
        var step = card.offsetWidth + gap;
        slider.scrollLeft = slider.scrollLeft + step;
      }, 3000);
    }
    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }
    function pauseAutoplayTemporarily() {
      stopAutoplay();
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(startAutoplay, 4000);
    }

    // Espera a que todo (incluidas las imágenes) esté cargado antes de medir y centrar,
    // para que el cálculo de posiciones sea exacto también en móvil.
    window.addEventListener('load', function () {
      measureLoopWidth();
      centerOnMiddleCard();
      startAutoplay();
    });
  })();
</script>

{% schema %}
{
  "name": "Reseñas con fotos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "¿Qué dicen nuestras clientas?"
    },
    {
      "type": "text",
      "id": "valoracion_texto",
      "label": "Texto de valoración",
      "default": "Excelente 4.8/5"
    },
    {
      "type": "text",
      "id": "subtitulo",
      "label": "Subtítulo (número de reseñas)",
      "default": "Más de 5.261 reseñas"
    },
    {
      "type": "color",
      "id": "color_estrellas",
      "label": "Color de las estrellas",
      "default": "#f6c343"
    }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "textarea", "id": "texto", "label": "Texto de la reseña", "default": "Estoy encantada con mi compra, la calidad superó mis expectativas." },
        { "type": "text", "id": "nombre", "label": "Nombre", "default": "María G." },
        { "type": "range", "id": "estrellas", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verificado", "label": "Mostrar sello 'Verificado'", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reseñas con fotos",
      "blocks": [
        { "type": "resena" },
        { "type": "resena" },
        { "type": "resena" },
        { "type": "resena" }
      ]
    }
  ]
}
{% endschema %}