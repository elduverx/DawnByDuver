    }
    .link-cta:hover { border-bottom-color: var(--verdigris); }

    /* Reseñas */
    blockquote.review {
      margin: 26px 0 22px;
      padding: 4px 0 4px 20px;
      border-left: 3px solid var(--copper);
      font-family: var(--serif);
      font-style: italic;
      font-size: 20px;
      line-height: 1.5;
    }
    blockquote.review cite {
