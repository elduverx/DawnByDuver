      text-align: center;
      padding: 16px;
      border: 1px dashed var(--copper-line);
    }

    p { margin: 0 0 1.1em; }
    strong { font-weight: 700; }

    /* Secciones */
    .item { padding: 44px 0 8px; }
    .item + .item { border-top: 1px solid var(--copper-line); margin-top: 24px; }
    .item figure { margin: 0 0 22px; }
    .num {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin: 0 0 8px;
