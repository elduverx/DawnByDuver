    /* Galería */
    .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 8px 0 14px; }
    .gallery img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
    .caption { font-size: 15px; color: var(--ink-soft); }

    /* Tabla */
    .table-scroll { overflow-x: auto; margin: 22px 0 22px; }
    table.compare { width: 100%; border-collapse: collapse; font-size: 16px; min-width: 520px; }
    .compare th, .compare td { padding: 12px 14px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--copper-line); }
    .compare thead th { font-family: var(--serif); font-size: 17px; }
    .compare thead th:first-child { color: var(--ink-soft); }
    .compare thead th:last-child { background: var(--verdigris); color: var(--white); }
    .compare tbody td:last-child { background: #eaf2ef; font-weight: 500; }
    .compare tbody th { font-weight: 500; color: var(--ink-soft); width: 20%; }

    /* Garantía */
    .guarantee {
      background: var(--verdigris);
