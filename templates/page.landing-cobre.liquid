      font-size: clamp(19px, 3.6vw, 23px);
      color: var(--copper);
      margin: 0 0 22px;
    }
    .byline {
      font-size: 15px;
      color: var(--ink-soft);
      padding: 12px 0;
      border-top: 1px solid var(--copper-line);
      border-bottom: 1px solid var(--copper-line);
      margin: 0 0 28px;
    }
    .author-photo { margin: 0 0 14px; }
    .author-photo img, .author-photo .ph { width: 100%; max-width: 420px; aspect-ratio: 1; object-fit: cover; border-radius: 4px; }
    .hero-img { margin: 28px 0 28px; }
    .hero-img img, .ph { border-radius: 4px; width: 100%; }

    .ph {
      aspect-ratio: 3 / 2;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--panel);
      color: var(--ink-soft);
