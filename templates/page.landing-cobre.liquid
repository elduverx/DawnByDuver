  <meta name="robots" content="noindex, nofollow">
  <title>10 razones para elegir joyas de cobre puro hechas a mano | La historia de María Fernanda</title>
  <meta name="description" content="Conoce 10 razones por las que las joyas de cobre artesanal están conquistando a las mujeres de Latinoamérica. Colección COBRE ARTESANAL de Casa Velaria.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,500&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>
    :root {
      --bg: #fbfaf7;
      --panel: #f1ece4;
      --ink: #2a1d16;
      --ink-soft: #5b4a3f;
      --copper: #b06a2e;
      --copper-line: #d9b48f;
      --verdigris: #1f5a4d;
      --verdigris-dark: #174438;
      --white: #ffffff;
      --serif: 'Fraunces', Georgia, 'Times New Roman', serif;
      --sans: 'Figtree', -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      box-sizing: border-box;
      padding-top: env(safe-area-inset-top, 0px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    *, *::before, *::after { box-sizing: inherit; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 18px;
      line-height: 1.65;
    }
    img { max-width: 100%; height: auto; display: block; }
    a { color: var(--verdigris); }
    a:focus-visible, .btn:focus-visible { outline: 3px solid var(--copper); outline-offset: 3px; }

    .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }

    /* Cabecera */
    .top { padding: 44px 0 8px; text-align: left; }
    .top h1 {
      font-family: var(--serif);
      font-weight: 700;
