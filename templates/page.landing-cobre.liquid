    .signoff { font-family: var(--serif); font-style: italic; font-size: 20px; margin: 34px 0 4px; }
    .signoff-name { font-size: 15px; color: var(--ink-soft); margin: 0; }

    .foot { padding: 28px 0 40px; font-size: 13px; line-height: 1.55; color: var(--ink-soft); }
