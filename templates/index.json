    "faq_vela_4ixKRc": {
      "type": "faq-vela",
      "blocks": {
        "pregunta_rYP4ck": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Donde puedo contactar con vosotras?",
            "respuesta": "Atendemos personalmente todos los mensajes durante este último período. Puedes escribirnos a contacto@casavelaria.com o a través de nuestra página de contacto, y te responderemos en menos de 24 horas."
          }
        },
        "pregunta_RqU6bn": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Ofrecen envío gratuito?",
            "respuesta": "Sí. Como pequeño gesto por nuestro aniversario, el envío es gratuito en todos los pedidos, sin importe mínimo. Verás todos los costes claramente antes de confirmar, y no habrá sorpresas ni costes ocultos al pagar."
          }
        },
        "pregunta_KmHeLC": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tarda en llegar mi pedido?",
            "respuesta": "Preparamos cada pedido con mucho cuidado. Normalmente lo tenemos listo en 1 o 2 días laborables y en cuanto sale por la puerta recibirás un correo con el número de seguimiento para saber dónde está en todo momento. La entrega suele tardar entre 7 y 12 días laborables."
          }
        },
        "pregunta_dHe8hC": {
          "type": "pregunta",
