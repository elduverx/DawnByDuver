<div style="display:none;">
  <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" onload="
    (function(img){
      var container = img.closest('variant-radios') || img.closest('variant-selects') || document.querySelector('variant-radios') || document.querySelector('variant-selects');
      if (container) {
        var fieldsets = container.querySelectorAll('[data-option-name]');
        fieldsets.forEach(function(fieldset) {
          var optName = (fieldset.getAttribute('data-option-name') || '').toLowerCase();
          if (optName.indexOf('color') === -1) return;
          var checkedInput = fieldset.querySelector('input[type=&quot;radio&quot;]:checked');
          if (!checkedInput) return;
          var label = fieldset.querySelector('.form__label');
          if (label) {
            label.innerHTML = '<strong style="font-weight: 600; color: #1a1a1a;">Color:</strong> ' + checkedInput.value;
          }
        });
      }
      img.remove();
    })(this);
  ">
</div>