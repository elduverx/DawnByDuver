{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- assign es_amalfi = false -%}
{%- for coleccion in product.collections -%}
  {%- if coleccion.handle == 'sandalias-amalfi' -%}
    {%- assign es_amalfi = true -%}
  {%- endif -%}
{%- endfor -%}
{%- assign es_costa_vela = false -%}
{%- for coleccion in product.collections -%}
  {%- if coleccion.handle == 'conjuntos-costa-vela' -%}
    {%- assign es_costa_vela = true -%}
  {%- endif -%}
{%- endfor -%}
{%- assign resto_stock = product.id | modulo: 7 -%}
{%- case product.handle -%}
  {%- when 'mono-casa-velaria-dias-de-verano' -%}
    {%- assign texto_urgencia = 'Sin stock' -%}
  {%- when 'isabelle-conjunto-de-3-piezas', 'elvira-conjunto-prado-fresco', 'zaida-conjunto-safari-de-lujo', 'elarisse-set-di-grazia-monocromatica', 'rosa-conjunto-riviera-a-rayas', 'valeria-conjunto-boho-en-capas' -%}
    {%- assign texto_urgencia = 'Solo quedan 4 en stock.' -%}
  {%- when 'victoria-conjunto-musa-moderna', 'aurora-conjunto-flor-de-cielo', 'celeste-conjunto-puro-lujo', 'elisa-conjunto-botanico' -%}
    {%- assign texto_urgencia = 'Solo quedan 6 en stock.' -%}
  {%- when 'laura-conjunto-flor-de-lavanda', 'luna-conjunto-paisley-costero', 'elena-conjunto-pop-al-amanecer', 'calystria-set-wild-grace' -%}
    {%- assign texto_urgencia = 'Solo quedan 2 en stock.' -%}
  {%- when 'solfi-sandalias-abiertas-y-antideslizantes', 'sophie-sandalias-confort-ajustables' -%}
    {%- assign texto_urgencia = 'Últimas unidades en stock' -%}
  {%- else -%}
    {%- case resto_stock -%}
      {%- when 0 or 4 -%}
        {%- assign texto_urgencia = 'Solo quedan 4 en stock.' -%}
      {%- when 1 or 5 -%}
        {%- assign texto_urgencia = 'Solo quedan 6 en stock.' -%}
      {%- when 2 or 6 -%}
        {%- assign texto_urgencia = 'Solo quedan 2 en stock.' -%}
      {%- else -%}
        {%- assign texto_urgencia = 'Últimas unidades en stock' -%}
    {%- endcase -%}
{%- endcase -%}
{%- assign urgencia_textos = 'Solo quedan 4 en stock.|Solo quedan 6 en stock.|Solo quedan 2 en stock.|Últimas unidades en stock' | split: '|' -%}
{%- assign base_index = 0 -%}
{%- for t in urgencia_textos -%}
  {%- if t == texto_urgencia -%}
    {%- assign base_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- assign color_option = null -%}
{%- unless product.handle == 'mono-casa-velaria-dias-de-verano' -%}
{%- for option in product.options_with_values -%}
  {%- assign option_name_downcase_color = option.name | downcase -%}
  {%- if option_name_downcase_color contains 'color' -%}
    {%- assign color_option = option -%}
  {%- endif -%}
{%- endfor -%}
{%- endunless -%}
{%- assign urgencia_map = '' -%}
{%- if color_option -%}
  {%- for value in color_option.values -%}
    {%- assign idx = base_index | plus: forloop.index0 | modulo: 4 -%}
    {%- assign texto_color = urgencia_textos[idx] -%}
    {%- assign entry = value | append: ':::' | append: texto_color -%}
    {%- if forloop.first -%}
      {%- assign urgencia_map = entry -%}
    {%- else -%}
      {%- assign urgencia_map = urgencia_map | append: '||' | append: entry -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if product.handle == 'eloise-conjunto-de-camiseta-sin-mangas-y-pantalones-anchos-de-algodon-y-lino-de-estilo-minimalista-para-mujer' -%}
  {%- assign urgencia_map_partes = urgencia_map | split: '||' -%}
  {%- assign urgencia_map_nuevo = '' -%}
  {%- for parte in urgencia_map_partes -%}
    {%- assign valor_color = parte | split: ':::' | first -%}
    {%- if valor_color == 'Negro' or valor_color == 'Azul Marino' -%}
      {%- assign parte = valor_color | append: ':::' | append: 'Sin stock' -%}
    {%- endif -%}
    {%- if forloop.first -%}
      {%- assign urgencia_map_nuevo = parte -%}
    {%- else -%}
      {%- assign urgencia_map_nuevo = urgencia_map_nuevo | append: '||' | append: parte -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign urgencia_map = urgencia_map_nuevo -%}
  {%- if color_option.selected_value == 'Negro' or color_option.selected_value == 'Azul Marino' -%}
    {%- assign texto_urgencia = 'Sin stock' -%}
  {%- endif -%}
{%- endif -%}
{%- if product.handle == 'emanuela-bolso-bandolera' -%}
  {%- assign urgencia_map_partes = urgencia_map | split: '||' -%}
  {%- assign urgencia_map_nuevo = '' -%}
  {%- for parte in urgencia_map_partes -%}
    {%- assign valor_color = parte | split: ':::' | first -%}
    {%- if valor_color == 'Marfil' or valor_color == 'Gris Perla' -%}
      {%- assign parte = valor_color | append: ':::' | append: 'Sin stock' -%}
    {%- endif -%}
    {%- if forloop.first -%}
      {%- assign urgencia_map_nuevo = parte -%}
    {%- else -%}
      {%- assign urgencia_map_nuevo = urgencia_map_nuevo | append: '||' | append: parte -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign urgencia_map = urgencia_map_nuevo -%}
  {%- if color_option.selected_value == 'Marfil' or color_option.selected_value == 'Gris Perla' -%}
    {%- assign texto_urgencia = 'Sin stock' -%}
  {%- endif -%}
{%- endif -%}
{%- if product.handle == 'mono-velaria-dias-de-primavera' -%}
  {%- assign texto_urgencia = 'Sin stock' -%}
  {%- assign urgencia_map_partes = urgencia_map | split: '||' -%}
  {%- assign urgencia_map_nuevo = '' -%}
  {%- for parte in urgencia_map_partes -%}
    {%- assign valor_color = parte | split: ':::' | first -%}
    {%- assign parte = valor_color | append: ':::' | append: 'Sin stock' -%}
    {%- if forloop.first -%}
      {%- assign urgencia_map_nuevo = parte -%}
    {%- else -%}
      {%- assign urgencia_map_nuevo = urgencia_map_nuevo | append: '||' | append: parte -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign urgencia_map = urgencia_map_nuevo -%}
{%- endif -%}
{%- assign tiene_talla_o_size = false -%}
{%- for option_check in product.options_with_values -%}
  {%- assign option_name_check = option_check.name | downcase -%}
  {%- if option_name_check contains 'talla' or option_name_check contains 'size' -%}
    {%- assign tiene_talla_o_size = true -%}
  {%- endif -%}
{%- endfor -%}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    style="display: block; margin-top: 20px;"
    {{ block.shopify_attributes }}
  >
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch" data-option-name="{{ option.name | escape }}">
         <legend class="form__label">{{ option.name }}</legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: button
          %}
        </fieldset>
    {%- elsif picker_type == 'button' or picker_type == 'dropdown' -%}
<fieldset class="js product-form__input product-form__input--pill" data-option-name="{{ option.name | escape }}">
{%- assign name_downcase = option.name | downcase -%}
<legend class="form__label" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
  <span><strong style="font-weight: 500; color: #333333;">{{ option.name }}:</strong> <span class="selected-option-{{ forloop.index }}" style="font-weight: 400;">{{ option.selected_value }}</span></span>
  {%- if name_downcase contains 'talla' or name_downcase contains 'size' -%}
    {%- if product.metafields.custom.tabla_tallas.value != blank -%}
    <modal-opener data-modal="#TablaTallasModal-{{ section.id }}">
      <button type="button" class="size-chart-link" aria-haspopup="dialog" style="display: inline-flex; align-items: center; gap: 5px; font-size: 1.3rem; color: #121212; text-decoration: underline; font-weight: 400; cursor: pointer; background: none; border: none; padding: 0; white-space: nowrap;">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 17 17 3l4 4L7 21z"></path>
          <path d="M14 6l2 2"></path>
          <path d="M11 9l2 2"></path>
          <path d="M8 12l2 2"></path>
          <path d="M5 15l2 2"></path>
        </svg>
        Guía de tallas
      </button>
    </modal-opener>
    {%- endif -%}
  {%- endif -%}
</legend>
{% render 'product-variant-options',
product: product,
option: option,
block: block,
picker_type: picker_type
%}
{%- assign mostrar_urgencia = false -%}
{%- if name_downcase contains 'talla' or name_downcase contains 'size' -%}
  {%- assign mostrar_urgencia = true -%}
{%- endif -%}
{%- if tiene_talla_o_size == false and forloop.last -%}
  {%- assign mostrar_urgencia = true -%}
{%- endif -%}
{%- if mostrar_urgencia -%}
  <div style="flex: 1 0 100%; width: 100%; margin-top: 8px; margin-bottom: 16px; font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: 400; color: rgb(0, 0, 0); line-height: normal;">
    <div style="display: flex; align-items: center; gap: 5px; margin-bottom: 8px;">
      <div style="flex: 1 1 0; min-height: 2px !important; height: 2px !important; background: #d9d5c9 !important; border-radius: 2px; display: block; line-height: 0; font-size: 0; overflow: hidden;"></div>
      <div style="flex: 1 1 0; min-height: 2px !important; height: 2px !important; background: #d9d5c9 !important; border-radius: 2px; display: block; line-height: 0; font-size: 0; overflow: hidden;"></div>
      <div style="flex: 1 1 0; min-height: 3px !important; height: 3px !important; background: #1a1a1a !important; border-radius: 2px; display: block; line-height: 0; font-size: 0; overflow: hidden;"></div>
      <div style="flex: 1 1 0; min-height: 2px !important; height: 2px !important; background: #d9d5c9 !important; border-radius: 2px; display: block; line-height: 0; font-size: 0; overflow: hidden;"></div>
      <div style="flex: 1 1 0; min-height: 2px !important; height: 2px !important; background: #d9d5c9 !important; border-radius: 2px; display: block; line-height: 0; font-size: 0; overflow: hidden;"></div>
    </div>
    <div style="display: flex; justify-content: space-between;">
      <span>Pequeño</span>
      <span>Fiel a la talla</span>
      <span>Grande</span>
    </div>
  </div>
  <style>
    @keyframes vela-punto-ping {
      0% { transform: scale(1); opacity: 0.7; }
      75%, 100% { transform: scale(2.2); opacity: 0; }
    }
    .punto-urgencia-wrapper {
      position: relative;
      width: 8px;
      height: 8px;
      min-width: 8px;
      display: inline-flex;
    }
    .punto-urgencia-wrapper .punto-urgencia-halo {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: #c0392b;
      animation: vela-punto-ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    .punto-urgencia-wrapper .punto-urgencia-nucleo {
      position: relative;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #c0392b;
    }
  </style>
  <p id="Urgencia-{{ section.id }}" data-urgencia-map="{{ urgencia_map | escape }}" style="margin-top: 12px; margin-bottom: 0; font-size: 1.3rem; font-weight: 600; color: #c0392b; display: flex; align-items: center; gap: 8px; line-height: 1.4;">
    <span class="punto-urgencia-wrapper">
      <span class="punto-urgencia-halo"></span>
      <span class="punto-urgencia-nucleo"></span>
    </span>
    <span id="UrgenciaTexto-{{ section.id }}">{{ texto_urgencia }}</span>
  </p>
  {%- if color_option -%}
  <script>
  document.addEventListener('change', function(e) {
    var wrap = e.target.closest('[data-option-name]');
    if (!wrap) return;
    var optName = (wrap.getAttribute('data-option-name') || '').toLowerCase();
    if (optName.indexOf('color') === -1) return;

    var p = document.getElementById('Urgencia-{{ section.id }}');
    if (!p) return;
    var mapRaw = p.getAttribute('data-urgencia-map');
    if (!mapRaw) return;
    var map = {};
    mapRaw.split('||').forEach(function(pair) {
      var parts = pair.split(':::');
      if (parts.length === 2) map[parts[0]] = parts[1];
    });
    var value = e.target.value;

    function aplicarTexto() {
      var span = document.getElementById('UrgenciaTexto-{{ section.id }}');
      if (span && value && map[value]) {
        span.textContent = map[value];
      }
    }
    aplicarTexto();
    setTimeout(aplicarTexto, 400);
    setTimeout(aplicarTexto, 900);
  });
  </script>
  {%- endif -%}
{%- endif -%}
</fieldset>
      {%- else -%}
        <div class="product-form__input product-form__input--dropdown" data-option-name="{{ option.name | escape }}">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
            <span>{{ option.name }}</span>
            {%- assign name_downcase = option.name | downcase -%}
            {%- if name_downcase contains 'talla' or name_downcase contains 'size' -%}
              {%- if product.metafields.custom.tabla_tallas.value != blank -%}
              <modal-opener data-modal="#TablaTallasModal-{{ section.id }}">
                <button type="button" class="size-chart-link" aria-haspopup="dialog" style="display: inline-flex; align-items: center; gap: 5px; font-size: 1.3rem; color: #121212; text-decoration: underline; font-weight: 400; cursor: pointer; background: none; border: none; padding: 0;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(-45deg);">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <line x1="9" y1="12" x2="9" y2="15"></line>
                    <line x1="14" y1="12" x2="14" y2="15"></line>
                  </svg>
                  Tabla de tallas
                </button>
              </modal-opener>
              {%- endif -%}
            {%- endif -%}
          </label>
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}
{%- if product.handle == 'eloise-conjunto-de-camiseta-sin-mangas-y-pantalones-anchos-de-algodon-y-lino-de-estilo-minimalista-para-mujer' -%}
<script>
(function() {
  var coloresSinStock = ['Negro', 'Azul Marino'];
  var aplicando = false;
  function colorSeleccionadoActual() {
    var color = null;
    document.querySelectorAll('[data-option-name]').forEach(function(fs) {
      var name = (fs.getAttribute('data-option-name') || '').toLowerCase();
      if (name.indexOf('color') === -1) return;
      var checked = fs.querySelector('input:checked');
      if (checked) color = checked.value;
      var select = fs.querySelector('select');
      if (select) color = select.value;
    });
    return color;
  }
  function forzarTexto() {
    if (aplicando) return;
    var color = colorSeleccionadoActual();
    var span = document.querySelector('[id^="UrgenciaTexto-"]');
    if (span && color && coloresSinStock.indexOf(color) !== -1 && span.textContent !== 'Sin stock') {
      aplicando = true;
      span.textContent = 'Sin stock';
      setTimeout(function() { aplicando = false; }, 50);
    }
  }
  document.addEventListener('change', forzarTexto);
  var contenedor = document.querySelector('.product__info-container') || document.body;
  new MutationObserver(function() {
    if (!aplicando) forzarTexto();
  }).observe(contenedor, { childList: true, subtree: true });
  forzarTexto();
})();
</script>
{%- endif -%}
{%- if product.handle == 'mono-velaria-dias-de-primavera' -%}
<script>
(function() {
  var aplicando = false;
  function forzarTexto() {
    if (aplicando) return;
    var span = document.querySelector('[id^="UrgenciaTexto-"]');
    if (span && span.textContent !== 'Sin stock') {
      aplicando = true;
      span.textContent = 'Sin stock';
      setTimeout(function() { aplicando = false; }, 50);
    }
  }
  document.addEventListener('change', forzarTexto);
  var contenedor = document.querySelector('.product__info-container') || document.body;
  new MutationObserver(function() {
    if (!aplicando) forzarTexto();
  }).observe(contenedor, { childList: true, subtree: true });
  forzarTexto();
})();
</script>
{%- endif -%}
